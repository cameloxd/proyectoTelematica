# Copia este archivo a .env y ajusta lo que necesites.
# Tamano de bloque en bytes (min 1 MiB, max 64 MiB): 4 MiB=4194304, 8 MiB=8388608, 16 MiB=16777216
DFS_BLOCK_SIZE_BYTES=8388608

# Host que los Clientes usan para llegar a los DataNodes.
# Local: localhost. En AWS/GCP: IP publica o DNS de la VM.
ADVERTISE_HOST=localhost

# Capacidad simulada por DataNode (5 GiB)
DATANODE_CAPACITY_BYTES=5368709120
