<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>co.eafit.dfsha</groupId>
  <artifactId>dfsha-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>DFSha</name>

  <modules>
    <module>dfsha-proto</module>
    <module>dfsha-common</module>
    <module>dfsha-client</module>
    <module>dfsha-controlnode</module>
    <module>dfsha-datanode</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.66.0</grpc.version>
    <!-- 3.25.3 es la version de protobuf con la que gRPC 1.66.0 esta construido -->
    <protobuf.version>3.25.3</protobuf.version>
    <slf4j.version>2.0.16</slf4j.version>
    <rabbitmq.version>5.21.0</rabbitmq.version>
    <hikari.version>5.1.0</hikari.version>
    <postgresql.version>42.7.4</postgresql.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>co.eafit.dfsha</groupId><artifactId>dfsha-proto</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>co.eafit.dfsha</groupId><artifactId>dfsha-common</artifactId><version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- JUnit 5 para las pruebas de todos los modulos -->
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <!--
          Jar ejecutable con todas las dependencias adentro: target/<modulo>.jar
          Lo activan client, controlnode y datanode; cada uno define la propiedad main.class.
        -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.5.1</version>
          <executions>
            <execution>
              <phase>package</phase>
              <goals><goal>shade</goal></goals>
              <configuration>
                <finalName>${project.artifactId}</finalName>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                    </excludes>
                  </filter>
                </filters>
                <transformers>
                  <!-- gRPC encuentra sus resolvedores y balanceadores en META-INF/services: hay que unirlos -->
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                    <mainClass>${main.class}</mainClass>
                  </transformer>
                </transformers>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
