<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>co.eafit.dfsha</groupId>
  <artifactId>dfsha-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>DFSha</name>

  <modules>
    <module>dfsha-proto</module>
    <module>dfsha-common</module>
    <module>dfsha-client</module>
    <module>dfsha-controlnode</module>
    <module>dfsha-datanode</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <grpc.version>1.66.0</grpc.version>
    <!-- 3.25.3 es la version de protobuf con la que gRPC 1.66.0 esta construido -->
    <protobuf.version>3.25.3</protobuf.version>
    <slf4j.version>2.0.16</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>co.eafit.dfsha</groupId><artifactId>dfsha-proto</artifactId><version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>co.eafit.dfsha</groupId><artifactId>dfsha-common</artifactId><version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
