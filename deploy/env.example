# Copia este archivo a .env (en deploy/) y ajusta lo que necesites.

# Tamaño de bloque en bytes: 4 MiB=4194304, 8 MiB=8388608, 16 MiB=16777216
BLOCK_SIZE_BYTES=8388608

# Copias de cada bloque. Con 4 DataNodes y factor 3 se puede reponer una copia si cae un nodo.
REPLICATION_FACTOR=3

# Espera mínima entre intentos de publicación de una tarea de borrado fallida (positivo).
DELETE_RETRY_SECONDS=10

# Host que los clientes usan para llegar a los DataNodes.
# Local: localhost. En AWS/GCP: la IP pública o el DNS de la VM
# (y genera los certificados con EXTRA_SAN, ver gen-secrets.sh).
ADVERTISE_HOST=localhost

# Capacidad simulada por DataNode (5 GiB): los contenedores comparten el disco del host.
DATANODE_CAPACITY_BYTES=5368709120

# Si el puerto 5432 está ocupado en tu máquina (Windows a veces lo reserva):
# POSTGRES_PORT=5433
